{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/locales/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(icons|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(icon\\.svg|icon\\.png|favicon\\.ico|manifest\\.webmanifest|manifest\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/catalog",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=7200"
        }
      ]
    },
    {
      "source": "/sw\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-static.xml",
      "destination": "/api/sitemap-static"
    },
    {
      "source": "/sitemap-buildings-:n.xml",
      "destination": "/api/sitemap-buildings?page=:n"
    },
    {
      "source": "/:lang(en|ca)/css/:path*",
      "destination": "/css/:path*"
    },
    {
      "source": "/:lang(en|ca)/js/:path*",
      "destination": "/js/:path*"
    },
    {
      "source": "/:lang(en|ca)/locales/:path*",
      "destination": "/locales/:path*"
    },
    {
      "source": "/:lang(en|ca)/icons/:path*",
      "destination": "/icons/:path*"
    },
    {
      "source": "/:lang(en|ca)/img/:path*",
      "destination": "/img/:path*"
    },
    {
      "source": "/:lang(en|ca)/obra",
      "destination": "/api/obra?lang=:lang"
    },
    {
      "source": "/:lang(en|ca)/obra/",
      "destination": "/api/obra?lang=:lang"
    },
    {
      "source": "/:lang(en|ca)/obra/:id*",
      "destination": "/api/obra?id=:id&lang=:lang"
    },
    {
      "source": "/:lang(en|ca)/categoria/:slug",
      "destination": "/api/categoria?slug=:slug&lang=:lang"
    },
    {
      "source": "/:lang(en|ca)/arquitecto/:nombre",
      "destination": "/api/arquitecto?nombre=:nombre&lang=:lang"
    },
    {
      "source": "/:lang(en|ca)/perfil",
      "destination": "/perfil.html"
    },
    {
      "source": "/:lang(en|ca)/itinerarios",
      "destination": "/itinerarios.html"
    },
    {
      "source": "/:lang(en|ca)/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/:lang(en|ca)",
      "destination": "/index.html"
    },
    {
      "source": "/:lang(en|ca)/",
      "destination": "/index.html"
    },
    {
      "source": "/obra",
      "destination": "/api/obra"
    },
    {
      "source": "/obra/",
      "destination": "/api/obra"
    },
    {
      "source": "/obra/:id*",
      "destination": "/api/obra?id=:id"
    },
    {
      "source": "/categoria/:slug",
      "destination": "/api/categoria?slug=:slug"
    },
    {
      "source": "/arquitecto/:nombre",
      "destination": "/api/arquitecto?nombre=:nombre"
    }
  ]
}

