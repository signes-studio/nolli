{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/locales/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(icons|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(icon\\.svg|icon\\.png|favicon\\.ico|manifest\\.webmanifest|manifest\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/catalog",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=7200"
        }
      ]
    },
    {
      "source": "/sw\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap\\.xsl",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?type=index"
    },
    {
      "source": "/sitemap-static.xml",
      "destination": "/api/sitemap?type=static"
    },
    {
      "source": "/sitemap-categories.xml",
      "destination": "/api/sitemap?type=categories"
    },
    {
      "source": "/sitemap-architects.xml",
      "destination": "/api/sitemap?type=architects"
    },
    {
      "source": "/sitemap-cities.xml",
      "destination": "/api/sitemap?type=cities"
    },
    {
      "source": "/sitemap-buildings-:n.xml",
      "destination": "/api/sitemap?type=buildings"
    },
    {
      "source": "/en/css/:path*",
      "destination": "/css/:path*"
    },
    {
      "source": "/ca/css/:path*",
      "destination": "/css/:path*"
    },
    {
      "source": "/en/js/:path*",
      "destination": "/js/:path*"
    },
    {
      "source": "/ca/js/:path*",
      "destination": "/js/:path*"
    },
    {
      "source": "/en/locales/:path*",
      "destination": "/locales/:path*"
    },
    {
      "source": "/ca/locales/:path*",
      "destination": "/locales/:path*"
    },
    {
      "source": "/en/icons/:path*",
      "destination": "/icons/:path*"
    },
    {
      "source": "/ca/icons/:path*",
      "destination": "/icons/:path*"
    },
    {
      "source": "/en/img/:path*",
      "destination": "/img/:path*"
    },
    {
      "source": "/ca/img/:path*",
      "destination": "/img/:path*"
    },
    {
      "source": "/en/obra",
      "destination": "/api/obra?lang=en"
    },
    {
      "source": "/ca/obra",
      "destination": "/api/obra?lang=ca"
    },
    {
      "source": "/en/obra/",
      "destination": "/api/obra?lang=en"
    },
    {
      "source": "/ca/obra/",
      "destination": "/api/obra?lang=ca"
    },
    {
      "source": "/en/obra/:id*",
      "destination": "/api/obra?id=:id&lang=en"
    },
    {
      "source": "/ca/obra/:id*",
      "destination": "/api/obra?id=:id&lang=ca"
    },
    {
      "source": "/en/categoria/:slug",
      "destination": "/api/categoria?slug=:slug&lang=en"
    },
    {
      "source": "/ca/categoria/:slug",
      "destination": "/api/categoria?slug=:slug&lang=ca"
    },
    {
      "source": "/en/arquitecto/:slug",
      "destination": "/api/arquitecto?slug=:slug&lang=en"
    },
    {
      "source": "/ca/arquitecto/:slug",
      "destination": "/api/arquitecto?slug=:slug&lang=ca"
    },
    {
      "source": "/en/ciudad/:slug",
      "destination": "/api/ciudad?slug=:slug&lang=en"
    },
    {
      "source": "/ca/ciudad/:slug",
      "destination": "/api/ciudad?slug=:slug&lang=ca"
    },
    {
      "source": "/en/lugar/:slug",
      "destination": "/api/ciudad?slug=:slug&lang=en"
    },
    {
      "source": "/ca/lugar/:slug",
      "destination": "/api/ciudad?slug=:slug&lang=ca"
    },
    {
      "source": "/en/perfil",
      "destination": "/perfil"
    },
    {
      "source": "/ca/perfil",
      "destination": "/perfil"
    },
    {
      "source": "/en/itinerarios",
      "destination": "/itinerarios"
    },
    {
      "source": "/ca/itinerarios",
      "destination": "/itinerarios"
    },
    {
      "source": "/en/landing",
      "destination": "/landing"
    },
    {
      "source": "/ca/landing",
      "destination": "/landing"
    },
    {
      "source": "/en/admin",
      "destination": "/admin"
    },
    {
      "source": "/ca/admin",
      "destination": "/admin"
    },
    {
      "source": "/en",
      "destination": "/index"
    },
    {
      "source": "/en/",
      "destination": "/index"
    },
    {
      "source": "/en/:path*",
      "destination": "/index"
    },
    {
      "source": "/ca",
      "destination": "/index"
    },
    {
      "source": "/ca/",
      "destination": "/index"
    },
    {
      "source": "/ca/:path*",
      "destination": "/index"
    },
    {
      "source": "/obra",
      "destination": "/api/obra"
    },
    {
      "source": "/obra/",
      "destination": "/api/obra"
    },
    {
      "source": "/obra/:id*",
      "destination": "/api/obra?id=:id"
    },
    {
      "source": "/categoria/:slug",
      "destination": "/api/categoria?slug=:slug"
    },
    {
      "source": "/arquitecto/:slug",
      "destination": "/api/arquitecto?slug=:slug"
    },
    {
      "source": "/ciudad/:slug",
      "destination": "/api/ciudad?slug=:slug"
    },
    {
      "source": "/lugar/:slug",
      "destination": "/api/ciudad?slug=:slug"
    }
  ]
}
