{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-static.xml",
      "destination": "/api/sitemap-static"
    },
    {
      "source": "/sitemap-buildings-:n.xml",
      "destination": "/api/sitemap-buildings?page=:n"
    },
    {
      "source": "/obra/:id",
      "destination": "/api/obra?id=:id"
    },
    {
      "source": "/categoria/:slug",
      "destination": "/api/categoria?slug=:slug"
    },
    {
      "source": "/arquitecto/:nombre",
      "destination": "/api/arquitecto?nombre=:nombre"
    }
  ]
}

